# Dedicated AWS matching-load-test environment. Copy on the app host only.
# Do not use real user data, Kakao secrets or production databases here.
BACKEND_BIND_ADDRESS=0.0.0.0
MYSQL_DATABASE=roundy_loadtest
MYSQL_USER=roundy_loadtest
MYSQL_PASSWORD=replace-with-random-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-root-password
# Base64URL-encoded random 32-byte value. Never commit the copied file.
JWT_SECRET=replace-with-base64url-32-byte-secret
