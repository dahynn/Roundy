# Public deployment template. Copy to .env.production on the server and replace every placeholder.
# Never commit the copied .env.production file.

ROUNDY_DOMAIN=roundy.example.com
ACME_EMAIL=operator@example.com

MYSQL_DATABASE=roundy
MYSQL_USER=roundy
MYSQL_PASSWORD=replace-with-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-long-minio-secret

JWT_SECRET=replace-with-base64-encoded-32-byte-secret
KAKAO_CLIENT_ID=replace-with-kakao-client-id
KAKAO_SECRET_KEY=replace-with-kakao-secret
KAKAO_ADMIN_KEY=replace-with-kakao-admin-key

# First deployment may need update to create the existing schema. Change to validate after confirming it.
JPA_DDL_AUTO=update

# Must point to the separately operated production OpenVidu media node.
OPENVIDU_URL=https://media.roundy.example.com
OPENVIDU_PUBLIC_URL=https://media.roundy.example.com
OPENVIDU_SECRET=replace-with-openvidu-secret

# The backend accepts face-verification callbacks only from this address or CIDR.
VERIFICATION_AI_SERVER_IPS=127.0.0.1
